{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "An encrypted message sent between players.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The encrypted message text." },
        "senderId": { "type": "string", "description": "The UID of the sender." },
        "senderName": { "type": "string", "description": "The name of the sender." },
        "recipientId": { "type": "string", "description": "UID of the recipient or 'all' for group chat." },
        "chatId": { "type": "string", "description": "Unique ID for the chat room (e.g., 'group' or sorted uids)." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the message was sent." }
      },
      "required": ["text", "senderId", "senderName", "recipientId", "chatId", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "A user profile with online presence.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages (group and private)."
    },
    "/users/{uid}": {
      "schema": "User",
      "description": "User presence and profile data."
    }
  }
}
