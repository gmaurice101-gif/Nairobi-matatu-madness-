// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: messages
// Document ID: auto-generated
// Fields:
//   - text: string (required, max 1000 chars) - Encrypted message content
//   - senderId: string (required) - UID of the sender
//   - senderName: string (required, max 50 chars) - Name of the sender
//   - timestamp: timestamp (required) - When the message was sent
//
// Collection: players
// Document ID: user UID
// Fields:
//   - uid: string (required) - User UID
//   - displayName: string (required, max 50 chars) - User display name
//   - photoURL: string (optional) - User photo URL
//   - highScore: number (optional) - User high score
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['text', 'senderId', 'senderName', 'timestamp', 'recipientId', 'chatId']) &&
               data.text is string && data.text.size() <= 5000 &&
               data.senderId == request.auth.uid &&
               data.senderName is string && data.senderName.size() <= 100 &&
               data.recipientId is string && data.recipientId.size() <= 128 &&
               data.chatId is string && data.chatId.size() <= 258 &&
               data.timestamp == request.time;
      }

      function isParticipant(chatId) {
        return chatId == 'group' || chatId.split('_').hasAny([request.auth.uid]);
      }

      // Allow read/list only if user is participant
      allow read, list: if isAuthenticated() && isParticipant(resource.data.chatId);
      
      allow create: if isAuthenticated() && 
                      isValidId(messageId) && 
                      isValidMessage(request.resource.data) &&
                      isParticipant(request.resource.data.chatId);
                      
      allow update, delete: if false;
    }

    match /users/{uid} {
      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.displayName is string && data.displayName.size() <= 100;
      }

      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) && isValidUser(request.resource.data);
      allow delete: if false;
    }
  }
}
